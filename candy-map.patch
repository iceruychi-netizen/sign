+.candy-zone { background-image: var(--w-bg); }
+.candy-zone-dots { background-image: radial-gradient(rgba(255, 255, 255, 0.6) 3px, transparent 3px); background-size: 34px 34px; }
+.candy-ribbon {
+  background-image: var(--w-ribbon);
+  color: var(--candy-white);
+  text-shadow: 0 2px 0 var(--w-lip);
+  box-shadow: inset 0 4px 0 rgba(255, 255, 255, 0.35), inset 0 -6px 0 rgba(0, 0, 0, 0.12);
